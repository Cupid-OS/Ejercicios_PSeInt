// Ejercicio 4: importe total de una compra
Proceso ImporteTotal
	Definir precio Como Real
	Definir unidades Como Entero
	Escribir Sin Saltar "Precio del producto: "
	Leer precio
	Escribir Sin Saltar "Unidades compradas: "
	Leer unidades
	Escribir "Importe total: ", precio * unidades, " EUR"
FinProceso